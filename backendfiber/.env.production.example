NODE_ENV=production
PORT=8084
PUBLIC_API_BASE_URL=https://api.fiber.yourdomain.com

# MongoDB (Atlas preferred for production)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/fiberhomemanage?retryWrites=true&w=majority
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=10
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
MONGO_SOCKET_TIMEOUT_MS=45000
MONGO_MAX_IDLE_TIME_MS=30000

# Auth
JWT_SECRET=replace_with_64_plus_random_characters
JWT_EXPIRES_IN=12h
API_REQUIRE_AUTH=true

# CORS and proxy
TRUST_PROXY=1
CORS_ORIGIN=https://app.fiber.yourdomain.com
CORS_CREDENTIALS=false

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=600000
AUTH_RATE_LIMIT_MAX=8

# Upload limits
REQUEST_BODY_LIMIT=10mb

# Bootstrap admin (rotate after first login)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=replace_with_strong_password
