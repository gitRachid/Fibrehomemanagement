# Copier vers api.dev.env pour surcharger docker-compose (optionnel)
# cp api.dev.env.example api.dev.env

NODE_ENV=development
PORT=8084
PUBLIC_API_BASE_URL=http://localhost:8084

MONGODB_URI=mongodb://mongodb:27017/fiberhomemanage
JWT_SECRET=dev_only_change_me
JWT_EXPIRES_IN=12h
API_REQUIRE_AUTH=false
ADMIN_EMAIL=admin@fiber.local
ADMIN_PASSWORD=admin123

CORS_ORIGIN=http://localhost:8081,http://localhost:3000,exp://localhost:8081
CORS_CREDENTIALS=false

REDIS_URL=redis://redis:6379
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=fiber-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
