NODE_ENV=production
PORT=8084
PUBLIC_API_BASE_URL=https://api.your-domain.com

MONGODB_URI=mongodb://mongodb:27017/fiberhomemanage?replicaSet=rs0
JWT_SECRET=replace_with_strong_random_secret
JWT_EXPIRES_IN=12h
API_REQUIRE_AUTH=true

TRUST_PROXY=1
REQUEST_BODY_LIMIT=25mb
CORS_ORIGIN=https://app.your-domain.com,https://admin.your-domain.com
CORS_CREDENTIALS=false

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=600000
AUTH_RATE_LIMIT_MAX=10

MONGO_MAX_POOL_SIZE=100
MONGO_MIN_POOL_SIZE=10
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
MONGO_SOCKET_TIMEOUT_MS=45000
MONGO_MAX_IDLE_TIME_MS=30000

REDIS_URL=redis://redis:6379
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=fiber-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=replace_me
